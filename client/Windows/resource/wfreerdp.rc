
#include "resource.h"
#include <windows.h>

IDI_ICON1              ICON                    "FreeRDP.ico"
IDB_MINIMIZE           BITMAP                  "minimize.bmp"
IDB_MINIMIZE_ACT       BITMAP                  "minimize_active.bmp"
IDB_LOCK               BITMAP                  "lock.bmp"
IDB_LOCK_ACT           BITMAP                  "lock_active.bmp"
IDB_UNLOCK             BITMAP                  "unlock.bmp"
IDB_UNLOCK_ACT         BITMAP                  "unlock_active.bmp"
IDB_CLOSE              BITMAP                  "close.bmp"
IDB_CLOSE_ACT          BITMAP                  "close_active.bmp"
IDB_RESTORE            BITMAP                  "restore.bmp"
IDB_RESTORE_ACT        BITMAP                  "restore_active.bmp"

IDD_STUDIO_CONNECT DIALOGEX 0, 0, 250, 138
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remote Desktop"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Computer (host or host:port):", -1, 10, 8, 220, 10
    COMBOBOX        IDC_STUDIO_SERVER, 10, 19, 230, 80, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "User name:", -1, 10, 48, 60, 10
    EDITTEXT        IDC_STUDIO_USER, 74, 46, 166, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Password:", -1, 10, 68, 60, 10
    EDITTEXT        IDC_STUDIO_PASSWORD, 74, 66, 166, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "Remember password", IDC_STUDIO_REMEMBER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 74, 84, 166, 12
    DEFPUSHBUTTON   "Connect", IDOK, 146, 112, 44, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 112, 44, 16
END
