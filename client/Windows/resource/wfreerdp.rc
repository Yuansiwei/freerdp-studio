
#pragma code_page(65001)
#include "resource.h"
#include <windows.h>

IDI_ICON1              ICON                    "FreeRDP.ico"
IDB_MINIMIZE           BITMAP                  "minimize.bmp"
IDB_MINIMIZE_ACT       BITMAP                  "minimize_active.bmp"
IDB_LOCK               BITMAP                  "lock.bmp"
IDB_LOCK_ACT           BITMAP                  "lock_active.bmp"
IDB_UNLOCK             BITMAP                  "unlock.bmp"
IDB_UNLOCK_ACT         BITMAP                  "unlock_active.bmp"
IDB_CLOSE              BITMAP                  "close.bmp"
IDB_CLOSE_ACT          BITMAP                  "close_active.bmp"
IDB_RESTORE            BITMAP                  "restore.bmp"
IDB_RESTORE_ACT        BITMAP                  "restore_active.bmp"

IDD_STUDIO_CONNECT DIALOGEX 0, 0, 300, 182
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "远程桌面连接"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    CONTROL         IDI_ICON1, IDC_STUDIO_ICON, "Static", SS_ICON | WS_CHILD, 12, 14, 32, 32
    LTEXT           "远程桌面\n连接", IDC_STUDIO_TITLE, 54, 12, 150, 40
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ | WS_CHILD, 0, 78, 300, 1

    LTEXT           "计算机(&C):", -1, 11, 92, 46, 9
    COMBOBOX        IDC_STUDIO_SERVER, 61, 89, 228, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "用户名(&U):", -1, 11, 110, 46, 9
    EDITTEXT        IDC_STUDIO_USER, 61, 108, 228, 13, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "密码(&P):", -1, 11, 128, 46, 9
    EDITTEXT        IDC_STUDIO_PASSWORD, 61, 126, 228, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP

    CONTROL         "记住密码(&R)", IDC_STUDIO_REMEMBER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 61, 142, 120, 9

    LTEXT           "将使用保存的凭据连接到此计算机。", -1, 11, 154, 220, 9

    DEFPUSHBUTTON   "连接(&N)", IDOK, 178, 164, 54, 14
    PUSHBUTTON      "帮助(&H)", IDC_STUDIO_HELP, 236, 164, 54, 14
END
